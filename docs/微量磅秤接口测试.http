### ============================================================
### 微量磅秤系统数据 Http API 接口测试
### 查询接口 Base URL: {{aws_host}}/aws/api
### 写入接口 Base URL: {{aws_host}}/aws/api/wr
### ============================================================


### ============================================================
### 一、查询类接口 (GET)
### ============================================================


### 2. 查询工单数据
# @name getWorkOrder
# 参数说明:
#   machineId    - 设备编号 (必填)
#   workOrderNo  - 工单编号 (可选)
#   formulaCode  - 配方编号 (可选)
#   orderDateFrom - 起始日期 yyyyMMdd (可选)
#   orderDateTo   - 截止日期 yyyyMMdd (可选)
#   orderState   - 工单状态: 1未生产 2生产中 3已完工, 多个用逗号分隔 (可选)
GET {{aws_host}}/aws/api?option=getWorkOrder&plant={{plant}}&machineId={{machineId}}&workOrderNo=&formulaCode=&orderDateFrom=20190301&orderDateTo=20260401&orderState=
Accept: application/json

> {%
    client.log("=== 查询工单数据 ===");
    client.log("Status: " + response.status);
    client.log("Response: " + JSON.stringify(response.body, null, 2));
    client.test("请求成功", function() {
        client.assert(response.status === 200, "HTTP 状态码应为 200");
    });
    client.test("返回格式正确", function() {
        client.assert(response.body.hasOwnProperty("success"), "应包含 success 字段");
        client.assert(response.body.hasOwnProperty("rtnmsg"), "应包含 rtnmsg 字段");
        client.assert(response.body.hasOwnProperty("rtndata"), "应包含 rtndata 字段");
    });
%}

###


### 3. 查询称量记录
# @name getWeighingRecord
# 参数说明:
#   machineId     - 设备编号 (必填)
#   workOrderNo   - 工单编号 (可选)
#   formulaCode   - 配方编号 (可选)
#   weighTimeFrom - 起始时间 yyyyMMddHHmmss (必填)
#   weighTimeTo   - 截止时间 yyyyMMddHHmmss (必填)
GET {{aws_host}}/aws/api?option=getWeighingRecord&plant={{plant}}&machineId={{machineId}}&workOrderNo=&formulaCode=&weighTimeFrom=20190302152000&weighTimeTo=20260302173000
Accept: application/json

> {%
    client.log("=== 查询称量记录 ===");
    client.log("Status: " + response.status);
    client.log("Response: " + JSON.stringify(response.body, null, 2));
    client.test("请求成功", function() {
        client.assert(response.status === 200, "HTTP 状态码应为 200");
    });
    client.test("返回格式正确", function() {
        client.assert(response.body.hasOwnProperty("success"), "应包含 success 字段");
    });
%}

