#   unitBarcodeWeight - 单位条码重量 kg (可选)
#   expirationDate    - 有效期 yyyy-MM-dd (可选)
#   lotNo             - 生产批号 (可选)
GET {{mws_host}}/mws/api?option=getMaterialBarcode&plant={{plant}}&machineId={{machineId}}&barcode=&materialNo=&unitBarcodeWeight=&expirationDate=&lotNo=
Accept: application/json

