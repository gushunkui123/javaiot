### ============================================================
### DC250031 作业流程改进解决方案 - 接口测试
### 主磅查询 Base URL: {{mws_host}}/mws/api
### 主磅写入 Base URL: {{mws_host}}/mws/api/wr
### 微量查询 Base URL: {{aws_host}}/aws/api
### 微量写入 Base URL: {{aws_host}}/aws/api/wr
### 环境变量: 复用 docs/http-client.env.json
### 说明: 小料扫码防错、贴标机 TCP 通讯不属于 IDEA HTTP Client 请求，未在此文件中实现
### ============================================================


### ============================================================
### 一、原料基本资料（主磅 / 微量）
### ============================================================


### 1.1 查询原料基本资料 - 主磅
# @name getPartsMws
# 参数说明:
#   plant             - 厂别 (可选)
#   machineId         - 设备编号 (必填)
#   partNo            - 原料编号 (可选)
#   partName          - 原料名称 (可选)
#   partClass         - 原料类别 (可选): 5=原料, 2=胶料
#   unitBarcodeWeight - 单位条码重量 kg (可选)
GET {{mws_host}}/mws/api?option=getParts&plant={{plant}}&machineId={{machineId}}&partNo=&partName=&partClass=&unitBarcodeWeight=
Accept: application/json

> {%
    client.log("=== 查询原料基本资料 - 主磅 ===");
    client.log("Status: " + response.status);
    client.log("Response: " + JSON.stringify(response.body, null, 2));
    client.test("请求成功", function() {
        client.assert(response.status === 200, "HTTP 状态码应为 200");
    });
    client.test("返回格式正确", function() {
        client.assert(response.body.hasOwnProperty("success"), "应包含 success 字段");
        client.assert(response.body.hasOwnProperty("rtnmsg"), "应包含 rtnmsg 字段");
        client.assert(response.body.hasOwnProperty("rtndata"), "应包含 rtndata 字段");
    });
%}

