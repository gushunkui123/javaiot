### ============================================================
### 五、密炼工艺（主磅）
### ============================================================


### 5.1 更新配方工艺
# @name updateFormulaProcessMws
# 参数说明:
#   plant                    - 厂别 (可选)
#   machineId                - 设备编号 (必填)
#   formulaCode              - 配方编号 (必填)
#   FormulaProcessEntryList  - 工艺步骤集合，最后一步必须为 ActionID=9 排料
POST {{mws_host}}/mws/api/wr
Content-Type: application/json

{
  "option": "updateFormulaProcess",
  "plant": "{{plant}}",
  "machineId": {{machineId}},
  "formulaCode": "F001",
  "formulaName": "配方001",
  "FormulaProcessEntryList": [
    {
      "StepNo": 1,
      "ActionID": 2,
      "MixingTime": 0.0,
      "MixingCurrent": 0.0,
      "MixingTemp": 0.0,
      "RotateSpeed": 0.0,
      "Pressure": 0.0,
      "ClosingConditionID": 0,
      "TurningTimes": 0.0,
      "RisingTime": 0.0,
      "FallingTime": 0.0
    },
    {
      "StepNo": 2,
      "ActionID": 9,
      "MixingTime": 0.0,
      "MixingCurrent": 0.0,
      "MixingTemp": 0.0,
      "RotateSpeed": 0.0,
      "Pressure": 0.0,
      "ClosingConditionID": 0,
      "TurningTimes": 0.0,
      "RisingTime": 0.0,
      "FallingTime": 0.0
    }
  ]
}

> {%
    client.log("=== 更新配方工艺 - 主磅 ===");
    client.log("Status: " + response.status);
    client.log("Response: " + JSON.stringify(response.body, null, 2));
    client.test("请求成功", function() {
        client.assert(response.status === 200, "HTTP 状态码应为 200");
    });
    client.test("返回格式正确", function() {
        client.assert(response.body.hasOwnProperty("success"), "应包含 success 字段");
        client.assert(response.body.hasOwnProperty("rtnmsg"), "应包含 rtnmsg 字段");
    });
%}

