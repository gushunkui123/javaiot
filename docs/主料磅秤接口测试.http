### 4. 查询报警记录
# @name getAlarmLog
# 参数说明:
#   machineId     - 设备编号 (必填)
#   alarmGroup    - 报警类别 (可选): 1-1号秤异常, 2-2号秤异常, 3-3号秤异常, 0-胶料秤异常, 10-密炼机异常, 100-其他异常
#   alarmTimeFrom - 起始时间 yyyyMMddHHmmss (必填)
#   alarmTimeTo   - 截止时间 yyyyMMddHHmmss (必填)
GET {{mws_host}}/mws/api?option=getAlarmLog&plant={{plant}}&machineId={{machineId}}&alarmGroup=&alarmTimeFrom=20190302152000&alarmTimeTo=20260302173000
Accept: application/json

> {%
    client.log("=== 查询报警记录 ===");
    client.log("Status: " + response.status);
    client.log("Response: " + JSON.stringify(response.body, null, 2));
    client.test("请求成功", function() {
        client.assert(response.status === 200, "HTTP 状态码应为 200");
    });
    client.test("返回格式正确", function() {
        client.assert(response.body.hasOwnProperty("success"), "应包含 success 字段");
    });
%}

