### ============================================================
### 四、写入类接口 (POST) - 配方数据
### ============================================================


### 9.1 新增配方
# @name addFormula
# 注意: 主料磅秤配方多一个 StepNo (下料段序) 字段
POST {{mws_host}}/mws/api/wr
Content-Type: application/json

{
  "option": "addFormula",
  "plant": "{{plant}}",
  "machineId": {{machineId}},
  "formulaCode": "F001",
  "formulaName": "配方 01",
  "FormulaEntryList": [
    {"MaterialNo": "ZNO01", "MaterialWeight": 28.0, "StepNo": 1},
    {"MaterialNo": "ZNO02", "MaterialWeight": 61.0, "StepNo": 1}
  ]
}

> {%
    client.log("=== 新增配方 ===");
    client.log("Status: " + response.status);
    client.log("Response: " + JSON.stringify(response.body, null, 2));
    client.test("请求成功", function() {
        client.assert(response.status === 200, "HTTP 状态码应为 200");
    });
%}

